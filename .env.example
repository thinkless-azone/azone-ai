PUBLIC_CONTACT_FUNCTION_URL=https://functions.yandexcloud.net/your-function-id
PUBLIC_YANDEX_METRIKA_ID=00000000

# IndexNow — сигнал Яндексу на переобход новых/изменённых URL (yandex.com/indexnow, npm run deploy)
# Ключ создаётся автоматически: npm run indexnow:setup → файл public/{ключ}.txt
INDEXNOW_KEY=
SITE_URL=https://azoneai.ru
# NOTIFY_INDEXNOW=all — при следующем деплое отправить все URL из sitemap (не только новые)
# INDEXNOW_GLOBAL=1 — опционально Bing (api.indexnow.org), не для робота Яндекса

# Деплой в Object Storage (npm run deploy): статический ключ доступа сервисного аккаунта
# Либо положите те же ключи в %USERPROFILE%\.aws\credentials под профилем [yc]
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ru-central1
# AWS_PROFILE=yc

{
  "name": "azoneai-site",
  "type": "module",
  "version": "1.0.0",
  "dependencies": {
    "@astrojs/sitemap": "^3.3.0",
    "@astrojs/tailwind": "^6.0.2",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/space-grotesk": "^5.2.10",
    "astro": "^5.18.1",
    "tailwindcss": "^3.4.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/ensure-indexnow-key.mjs && astro build && node scripts/add-sitemap-lastmod.mjs && pagefind --site dist",
    "preview": "astro preview",
    "deploy": "npm run build && node scripts/deploy-s3.mjs && node scripts/notify-search-engines.mjs",
    "deploy:only": "node scripts/deploy-s3.mjs && node scripts/notify-search-engines.mjs",
    "indexnow:setup": "node scripts/ensure-indexnow-key.mjs --init",
    "notify:index": "node scripts/notify-search-engines.mjs",
    "package:function": "node scripts/package-contact-function.mjs"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.750.0",
    "@aws-sdk/credential-providers": "^3.750.0",
    "pagefind": "^1.5.0"
  }
}

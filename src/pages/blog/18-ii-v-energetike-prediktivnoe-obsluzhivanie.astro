                    <th class="text-center px-5 py-4 font-semibold text-red-400">Публичное облако</th>
                    <th class="text-center px-5 py-4 font-semibold text-green-400">On-premise / закрытый контур</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-white/5">
                  {cloudVsOnprem.map((row) => (

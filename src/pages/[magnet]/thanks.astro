---
import Base from '../../layouts/Base.astro';
import { leadMagnets } from '../../data/leadMagnets.js';

export function getStaticPaths() {
  return leadMagnets.map((m) => ({ params: { magnet: m.slug }, props: { magnet: m } }));
}

const { magnet } = Astro.props;
---

<Base
  title="Спасибо — документ готов к скачиванию"
  description={`«${magnet.metaTitle}» готов к скачиванию.`}
  breadcrumbTitle="Скачивание документа"
  noindex={true}
>
  <div class="min-h-screen pt-24 pb-24 relative">
    <div class="absolute top-1/3 left-1/2 -translate-x-1/2 w-[700px] h-[700px] bg-accent/10 rounded-full blur-[150px] pointer-events-none"></div>

    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
      <div class="w-16 h-16 rounded-2xl bg-accent/20 flex items-center justify-center mx-auto mb-8">
        <svg class="w-8 h-8 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
          <polyline points="22 4 12 14.01 9 11.01"></polyline>
        </svg>
      </div>

      <h1 class="text-3xl md:text-5xl font-heading font-bold text-white mb-6">Спасибо! Документ готов к скачиванию.</h1>

      <p class="text-muted-foreground mb-4 leading-relaxed">
        Заявка принята. Письмо со ссылкой на PDF отправлено на указанный email — если его нет в течение 5 минут, проверьте папку «Спам».
      </p>

      <a
        id="leadMagnetDownloadBtn"
        href={magnet.pdf.url}
        download={magnet.pdf.downloadName}
        class="premium-btn inline-flex items-center justify-center text-lg px-10 py-4 mb-12"
      >
        Скачать PDF ({magnet.pdf.sizeLabel})
      </a>

      <div class="glass-card p-8 text-left">
        <h2 class="text-xl font-bold text-white mb-6 text-center">Что дальше</h2>
        <ul class="space-y-5">
          {magnet.thanksSteps.map((step, i) => (
            <li class="flex items-start gap-3">
              <span class="text-accent font-bold shrink-0">{i + 1}.</span>
              <span class="text-muted-foreground text-sm leading-relaxed" set:html={step}></span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>

  <script is:inline define:vars={{ downloadGoal: magnet.goals.download }}>
    document.getElementById('leadMagnetDownloadBtn')?.addEventListener('click', () => {
      if (typeof window.trackAnalyticsGoal === 'function') {
        window.trackAnalyticsGoal(downloadGoal);
      }
    });
  </script>
</Base>

---
interface Props {
  source: string;
}

const { source } = Astro.props;
const href = `/whitepaper/?source=${encodeURIComponent(source)}`;
---

<section class="py-12" data-whitepaper-callout data-source={source}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="glass-card glow-border border border-accent/30 p-6 md:p-8 flex flex-col md:flex-row md:items-center gap-6">
      <div class="w-12 h-12 rounded-xl bg-accent/20 flex items-center justify-center shrink-0">
        <svg class="w-6 h-6 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
          <polyline points="14 2 14 8 20 8"></polyline>
          <line x1="16" y1="13" x2="8" y2="13"></line>
          <line x1="16" y1="17" x2="8" y2="17"></line>
          <polyline points="10 9 9 9 8 9"></polyline>
        </svg>
      </div>
      <div class="flex-grow min-w-0">
        <h3 class="text-lg md:text-xl font-bold text-white mb-2">
          Технический документ: Архитектура внедрения LLM в закрытом контуре КИИ
        </h3>
        <p class="text-sm text-muted-foreground leading-relaxed">
          PDF ~20 страниц для CISO и архитекторов. Регуляторный контекст, эталонная архитектура, чек-лист готовности к пилоту.
        </p>
      </div>
      <a
        href={href}
        class="premium-btn whitespace-nowrap text-center shrink-0 w-full md:w-auto"
        data-ym-goal="whitepaper_cta_click"
        data-download-type="whitepaper"
        data-placement="whitepaper_callout"
        data-ym-param-source={source}
      >
        Скачать PDF
      </a>
    </div>
  </div>
</section>

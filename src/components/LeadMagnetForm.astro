---
// LeadMagnetForm.astro — единая форма захвата лида для всех whitepaper.
// Логика, разметка и валидация описаны один раз; различия приходят из объекта magnet.
// Бэкенд — Yandex Cloud Function (как в ContactForm). После успеха — редирект на /{slug}/thanks/.

interface Magnet {
  slug: string;
  magnetId: string;
  metaTitle: string;
  formTitle: string;
  formSubtitle: string;
  submitLabel: string;
  goals: { view: string; lead: string; download: string; cta: string };
}

interface Props {
  magnet: Magnet;
}

const { magnet } = Astro.props;

const FUNCTION_URL = import.meta.env.DEV
  ? '/api/contact'
  : import.meta.env.PUBLIC_CONTACT_FUNCTION_URL || 'https://functions.yandexcloud.net/d4erei6bq3unc5ficeqm';
---

<div class="glass-card p-8 md:p-10 glow-border lg:sticky lg:top-28">
  <h2 class="text-xl font-bold text-white mb-2">{magnet.formTitle}</h2>
  <p class="text-sm text-muted-foreground mb-6">{magnet.formSubtitle}</p>

  <form id="leadMagnetForm" class="space-y-6">
    <div style="position:absolute;left:-9999px;" aria-hidden="true">
      <input type="checkbox" name="bot_trap" value="1" tabindex="-1" autocomplete="off" />
    </div>

    <input type="hidden" name="magnet_id" value={magnet.magnetId} />
    <input type="hidden" name="magnet_title" value={magnet.metaTitle} />
    <input type="hidden" name="source" id="leadMagnetSourceField" value="" />

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="space-y-2">
        <label class="text-sm font-medium text-white/80" for="lm-name">Имя *</label>
        <input
          id="lm-name"
          name="name"
          required
          class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all"
          placeholder="Иван Иванов"
        />
      </div>
      <div class="space-y-2">
        <label class="text-sm font-medium text-white/80" for="lm-company">Компания *</label>
        <input
          id="lm-company"
          name="company"
          required
          class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all"
          placeholder="ООО Ромашка"
        />
      </div>
    </div>

    <div class="space-y-2">
      <label class="text-sm font-medium text-white/80" for="lm-email">Email *</label>
      <input
        id="lm-email"
        name="email"
        type="email"
        required
        class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all"
        placeholder="ivan@company.ru"
      />
    </div>

    <div class="space-y-2">
      <label class="text-sm font-medium text-white/80" for="lm-position">Должность</label>
      <input
        id="lm-position"
        name="position"
        class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all"
        placeholder="CISO, ИТ-директор, архитектор..."
      />
    </div>

    <label class="flex items-start gap-3 text-sm text-muted-foreground cursor-pointer">
      <input
        type="checkbox"
        id="leadMagnetPdnConsent"
        name="pdn_consent"
        value="1"
        required
        class="mt-1 rounded border-white/20"
      />
      <span>
        Согласен на обработку персональных данных в соответствии с{' '}
        <a href="/privacy/" class="text-accent hover:underline">политикой конфиденциальности</a>
      </span>
    </label>

    <button
      type="submit"
      id="leadMagnetSubmitBtn"
      disabled
      class="premium-btn w-full py-4 disabled:opacity-50 disabled:cursor-not-allowed"
    >
      {magnet.submitLabel}
    </button>
    <div id="leadMagnetFormStatus" class="text-center text-sm"></div>
    <p class="text-xs text-muted-foreground text-center leading-relaxed">
      После отправки откроется страница со ссылкой на скачивание PDF. Письмо с ссылкой придёт на указанный email.
    </p>
  </form>
</div>

<script
  type="module"
  define:vars={{
    FUNCTION_URL,
    slug: magnet.slug,
    magnetId: magnet.magnetId,
    magnetTitle: magnet.metaTitle,
    submitLabel: magnet.submitLabel,
    goals: magnet.goals,
  }}
>
  import { postContactFunction, contactFetchErrorMessage } from '/scripts/contact-api.js';

  if (typeof window.trackAnalyticsGoal === 'function') {
    window.trackAnalyticsGoal(goals.view);
  }

  const params = new URLSearchParams(window.location.search);
  const sourceField = document.getElementById('leadMagnetSourceField');
  if (sourceField) sourceField.value = params.get('source') || 'direct';

  const pdnConsent = document.getElementById('leadMagnetPdnConsent');
  const submitBtn = document.getElementById('leadMagnetSubmitBtn');

  function syncSubmitBtn() {
    if (!submitBtn || !pdnConsent) return;
    submitBtn.disabled = !pdnConsent.checked;
  }

  pdnConsent?.addEventListener('change', syncSubmitBtn);
  syncSubmitBtn();

  document.getElementById('leadMagnetForm')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target;
    const status = document.getElementById('leadMagnetFormStatus');
    const raw = Object.fromEntries(new FormData(form));

    if (raw.bot_trap === '1' || raw.bot_trap === 'on') return;

    if (!raw.pdn_consent) {
      status.style.color = '#ef4444';
      status.textContent = 'Необходимо согласие на обработку персональных данных';
      return;
    }

    const source = raw.source || 'direct';
    const position = (raw.position || '').trim();

    const payload = {
      type: 'lead_magnet',
      name: (raw.name || '').trim(),
      company: (raw.company || '').trim(),
      email: (raw.email || '').trim(),
      position: position || undefined,
      magnet_title: raw.magnet_title || magnetTitle,
      magnet_id: raw.magnet_id || magnetId,
      source,
      pdn_consent: true,
    };

    submitBtn.disabled = true;
    submitBtn.textContent = 'Отправка...';
    status.textContent = '';

    try {
      const { json, ok } = await postContactFunction(FUNCTION_URL, payload);
      if (ok) {
        if (typeof window.trackAnalyticsGoal === 'function') {
          window.trackAnalyticsGoal(goals.lead, { source });
        }
        window.location.assign(`/${slug}/thanks/`);
        return;
      }
      throw new Error(json.error || json.message || 'Ошибка отправки');
    } catch (err) {
      status.style.color = '#ef4444';
      status.textContent = contactFetchErrorMessage(err);
      submitBtn.textContent = submitLabel;
      syncSubmitBtn();
    }
  });
</script>
